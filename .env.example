# ==============================
# JARVIS Configuration
# ==============================
JARVIS_ENV=development

# ==============================
# IAAgent Bridge (Fase 5)
# ==============================
# IAAGENT_PATH=/path/to/IaAgent

# ==============================
# Gemini API (Fase 2 — IA híbrida)
# ==============================
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# ==============================
# Azure DevOps (Fase 5+ — QA Intelligence)
# ==============================
# AZDO_ORG=your-org
# AZDO_PAT=
# AZDO_REPOS=repo1,repo2
# AZDO_REPO_<NAME>_PROJECT=project-name
# AZDO_REPO_<NAME>_ID=uuid
# AZDO_ENABLE_PUBLISH=false

# ==============================
# KameCol (Fase 8 — Inteligencia comercial)
# ==============================
# KAMECOL_API_URL=https://your-kamecol-domain.com
# KAMECOL_DATABASE_URL=postgresql://user:password@host:5432/dbname
# KAMECOL_SESSION=

# ==============================
# MySQL QA Database (IntegratePIE)
# ==============================
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=

# ==============================
# Sentry (observabilidad)
# ==============================
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ==============================
# Trello (opcional)
# ==============================
# TRELLO_ENABLE=false
# TRELLO_KEY=
# TRELLO_TOKEN=

# ==============================
# SEGURIDAD
# ==============================
# - NUNCA commitear .env al repositorio
# - Rotar credenciales si se exponen a herramientas de IA
# - AZDO_PAT y KAMECOL_DATABASE_URL son los más sensibles
# - AZDO_ENABLE_PUBLISH=false por defecto (requiere activación explícita)
